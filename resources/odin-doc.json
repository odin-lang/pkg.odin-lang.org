{
    "domain": "odin-lang.org",
    "import_aliases": {
        "core:sys/darwin/Foundation": "NS",
        "vendor:darwin/Metal": "MTL",
        "vendor:darwin/QuartzCore": "CA",
        "vendor:darwin/MetalKit": "MTK",
        "vendor:darwin/CoreVideo": "CV"
    },
    "dense_packages": ["core:rexcode/isa/*"],
    "moved_packages": {
        "core:os/os2": "core:os",
        "vendor:darwin/Foundation": "core:sys/darwin/Foundation",
        "vendor:libc": "vendor:libc-shim"
    },
    "upstream_docs": {
        "vendor:sdl3":       {"title": "SDL Wiki", "url": "https://wiki.libsdl.org/SDL3/{name}", "type_prefix": "SDL_",
                              "skip": ["SDL_Sint", "SDL_Uint", "SDL_AndroidExternalStorageFlags", "SDL_GLContextFlagBit", "SDL_GLContextReleaseFlagBit",
                                       "SDL_GLContextState", "SDL_HapticEffectId", "SDL_HapticType", "SDL_XTaskQueueHandle", "SDL_XUserHandle"]},
        "vendor:sdl3/image": {"title": "SDL Wiki", "url": "https://wiki.libsdl.org/SDL3_image/{name}", "type_prefix": "IMG_"},
        "vendor:sdl3/ttf":   {"title": "SDL Wiki", "url": "https://wiki.libsdl.org/SDL3_ttf/{name}"},
        "vendor:sdl2":       {"title": "SDL Wiki", "url": "https://wiki.libsdl.org/SDL2/{name}"},
        "vendor:sdl2/image": {"title": "SDL Wiki", "url": "https://wiki.libsdl.org/SDL2_image/{name}"},
        "vendor:sdl2/mixer": {"title": "SDL Wiki", "url": "https://wiki.libsdl.org/SDL2_mixer/{name}"},
        "vendor:sdl2/ttf":   {"title": "SDL Wiki", "url": "https://wiki.libsdl.org/SDL2_ttf/{name}"},
        "vendor:sdl2/net":   {"title": "SDL Wiki", "url": "https://wiki.libsdl.org/SDL2_net/{name}"},
        "vendor:curl":       {"title": "libcurl", "url": "https://curl.se/libcurl/c/{name}.html"},
        "vendor:lua/5.4":    {"title": "Lua Manual", "url": "https://www.lua.org/manual/5.4/manual.html#{name}", "skip": ["luaopen_"]},
        "vendor:vulkan":     {"title": "Vulkan", "url": "https://registry.khronos.org/vulkan/specs/latest/man/html/{name}.html", "names": "vulkan"}
    },
    "objc_docs": {
        "url": "https://developer.apple.com/documentation/{framework}/{class}?language=objc",
        "packages": {
            "core:sys/darwin/Foundation": "foundation",
            "vendor:darwin/Metal": "metal",
            "vendor:darwin/QuartzCore": "quartzcore",
            "vendor:darwin/MetalKit": "metalkit"
        },
        "classes": {
            "NSApplication": "appkit",
            "NSBitmapImageRep": "appkit",
            "NSColor": "appkit",
            "NSColorSpace": "appkit",
            "NSCursor": "appkit",
            "NSEvent": "appkit",
            "NSImage": "appkit",
            "NSImageRep": "appkit",
            "NSMenu": "appkit",
            "NSMenuDelegate": "appkit",
            "NSMenuItem": "appkit",
            "NSOpenPanel": "appkit",
            "NSPanel": "appkit",
            "NSPasteboard": "appkit",
            "NSResponder": "appkit",
            "NSRunningApplication": "appkit",
            "NSSavePanel": "appkit",
            "NSScreen": "appkit",
            "NSToolbar": "appkit",
            "NSView": "appkit",
            "NSWindow": "appkit",
            "NSBundle": "foundation/bundle",
            "NSProcessInfo": "foundation/processinfo",
            "NSRunLoop": "foundation/runloop",
            "NSUndoManager": "foundation/undomanager",
            "NSObject": "objectivec",
            "NSObjectProtocol": "objectivec",
            "Protocol": "objectivec",
            "CALayer": "quartzcore",
            "NSBlock": ""
        }
    },
    "collections": {
        "base": {
            "name": "base",
            "source_url": "https://github.com/odin-lang/Odin/tree/master/base",
            "base_url": "/base",
            "root_path": "$ODIN_ROOT/base",
            "license": {
                "text": "zlib",
                "url": "https://github.com/odin-lang/Odin/tree/master/LICENSE"
            },
            "home": {
                "title": "Base",
                "description": "The base every Odin program builds on: the runtime, built-in procedures, and compiler intrinsics. Required by every target and implementation of Odin."
            }
        },
        "core": {
            "name": "core",
            "source_url": "https://github.com/odin-lang/Odin/tree/master/core",
            "base_url": "/core",
            "root_path": "$ODIN_ROOT/core",
            "license": {
                "text": "zlib",
                "url": "https://github.com/odin-lang/Odin/tree/master/LICENSE"
            },
            "home": {
                "title": "Core",
                "description": "The core library: formatted printing, strings, memory and allocators, containers, math, encoding, OS access, threading, and more."
            }
        },
        "vendor": {
            "name": "vendor",
            "source_url": "https://github.com/odin-lang/Odin/tree/master/vendor",
            "base_url": "/vendor",
            "root_path": "$ODIN_ROOT/vendor",
            "license": {
                "text": "zlib",
                "url": "https://github.com/odin-lang/Odin/tree/master/LICENSE"
            },
            "home": {
                "title": "Vendor",
                "description": "Bindings to popular third-party libraries for graphics, windowing, audio, physics, and more, all shipped with the compiler."
            }
        }
    }
}
