{
    "domain": "odin-lang.org",
    "import_aliases": {
        "core:sys/darwin/Foundation": "NS",
        "vendor:darwin/Metal": "MTL",
        "vendor:darwin/QuartzCore": "CA",
        "vendor:darwin/MetalKit": "MTK",
        "vendor:darwin/CoreVideo": "CV"
    },
    "dense_packages": ["core:rexcode/isa/*", "core:sys/windows"],
    "first_build_packages": ["base:runtime", "core:time", "core:thread"],
    "example_folders": {
        "core:os":                     ["command_line_arguments", "console", "dir_info"],
        "core:mem/virtual":            ["arena_allocator"],
        "core:text/edit":              ["text_edit"],
        "core:sys/windows":            ["win32"],
        "core:sys/wasm/js":            ["wasm/js_wasm32"],
        "core:sys/darwin/Foundation":  ["metal"],
        "vendor:darwin/QuartzCore":    ["metal"],
        "vendor:directx/d3d11":        ["directx/d3d11_minimal_sdl2", "directx/d3d11_minimal_sdl3"],
        "vendor:directx/d3d12":        ["directx/d3d12_triangle_sdl2"],
        "vendor:directx/dxgi":         ["directx"],
        "vendor:directx/d3d_compiler": ["directx"],
        "vendor:lua/5.4":              ["lua"],
        "vendor:nanovg/gl":            ["nanovg"],
        "vendor:raylib/rlgl":          ["raylib"],
        "vendor:sdl2/image":           ["sdl2"],
        "vendor:wgpu/glfwglue":        ["wgpu/glfw-triangle"],
        "vendor:wgpu/sdl3glue":        ["wgpu/sdl3-triangle"]
    },
    "external_docs": {
        "core:sys/windows":         {"title": "Microsoft Learn", "url": "https://learn.microsoft.com/en-us/windows/win32/api/"},
        "core:sys/linux":           {"title": "Linux man pages", "url": "https://man7.org/linux/man-pages/"},
        "core:sys/posix":           {"title": "POSIX", "url": "https://pubs.opengroup.org/onlinepubs/9799919799/"},
        "core:c/libc":              {"title": "cppreference", "url": "https://en.cppreference.com/c"},
        "vendor:directx/*":         {"title": "Microsoft Learn", "url": "https://learn.microsoft.com/en-us/windows/win32/directx"},
        "vendor:windows/GameInput": {"title": "Microsoft Learn", "url": "https://learn.microsoft.com/en-us/gaming/gdk/docs/features/common/input/overviews/input-overview"},
        "vendor:windows/XAudio2":   {"title": "Microsoft Learn", "url": "https://learn.microsoft.com/en-us/windows/win32/xaudio2/xaudio2-apis-portal"},
        "vendor:OpenGL":            {"title": "docs.gl", "url": "https://docs.gl/"},
        "vendor:vulkan":            {"title": "Vulkan", "url": "https://docs.vulkan.org/spec/latest/index.html"},
        "vendor:curl":              {"title": "libcurl", "url": "https://curl.se/libcurl/c/"},
        "vendor:lua/5.4":           {"title": "Lua Manual", "url": "https://www.lua.org/manual/5.4/manual.html"},
        "vendor:raylib":            {"title": "raylib cheatsheet", "url": "https://www.raylib.com/cheatsheet/cheatsheet.html"},
        "vendor:raylib/rlgl":       {"title": "raylib cheatsheet", "url": "https://www.raylib.com/cheatsheet/cheatsheet.html"},
        "vendor:glfw":              {"title": "GLFW", "url": "https://www.glfw.org/docs/latest/"},
        "vendor:glfw/bindings":     {"title": "GLFW", "url": "https://www.glfw.org/docs/latest/"},
        "vendor:box2d":             {"title": "Box2D", "url": "https://box2d.org/documentation/"},
        "vendor:box3d":             {"title": "Box3D", "url": "https://github.com/erincatto/box3d"},
        "vendor:cgltf":             {"title": "cgltf", "url": "https://github.com/jkuhlmann/cgltf"},
        "vendor:commonmark":        {"title": "cmark", "url": "https://github.com/commonmark/cmark"},
        "vendor:compress/lz4":      {"title": "LZ4", "url": "https://github.com/lz4/lz4"},
        "vendor:ENet":              {"title": "ENet", "url": "http://enet.bespin.org/"},
        "vendor:OpenEXRCore":       {"title": "OpenEXR", "url": "https://openexr.com/en/latest/"},
        "vendor:darwin/CoreVideo":  {"title": "Apple Docs", "url": "https://developer.apple.com/documentation/corevideo"},
        "vendor:fontstash":         {"title": "fontstash", "url": "https://github.com/memononen/fontstash"},
        "vendor:ggpo":              {"title": "GGPO", "url": "https://github.com/pond3r/ggpo"},
        "vendor:kb_text_shape":     {"title": "kb", "url": "https://github.com/JimmyLefevre/kb"},
        "vendor:miniaudio":         {"title": "miniaudio", "url": "https://miniaud.io/docs/"},
        "vendor:nanovg":            {"title": "NanoVG", "url": "https://github.com/memononen/nanovg"},
        "vendor:nanovg/gl":         {"title": "NanoVG", "url": "https://github.com/memononen/nanovg"},
        "vendor:portmidi":          {"title": "PortMidi", "url": "https://github.com/PortMidi/portmidi"},
        "vendor:stb/*":             {"title": "stb", "url": "https://github.com/nothings/stb"},
        "vendor:wasm/WebGL":        {"title": "MDN", "url": "https://developer.mozilla.org/en-US/docs/Web/API/WebGL_API"},
        "vendor:wgpu":              {"title": "WebGPU", "url": "https://www.w3.org/TR/webgpu/"},
        "vendor:wgpu/*":            {"title": "WebGPU", "url": "https://www.w3.org/TR/webgpu/"},
        "vendor:x11/xlib":          {"title": "Xlib", "url": "https://www.x.org/releases/current/doc/libX11/libX11/libX11.html"},
        "vendor:zlib":              {"title": "zlib", "url": "https://zlib.net/manual.html"}
    },
    "moved_packages": {
        "core:os/os2": "core:os",
        "vendor:darwin/Foundation": "core:sys/darwin/Foundation",
        "vendor:libc": "vendor:libc-shim"
    },
    "upstream_docs": {
        "vendor:sdl3":       {"title": "SDL Wiki", "url": "https://wiki.libsdl.org/SDL3/{name}", "type_prefix": "SDL_",
                              "skip": ["SDL_Sint", "SDL_Uint", "SDL_AndroidExternalStorageFlags", "SDL_GLContextFlagBit", "SDL_GLContextReleaseFlagBit",
                                       "SDL_GLContextState", "SDL_HapticEffectId", "SDL_HapticType", "SDL_XTaskQueueHandle", "SDL_XUserHandle"]},
        "vendor:sdl3/image": {"title": "SDL Wiki", "url": "https://wiki.libsdl.org/SDL3_image/{name}", "type_prefix": "IMG_"},
        "vendor:sdl3/ttf":   {"title": "SDL Wiki", "url": "https://wiki.libsdl.org/SDL3_ttf/{name}"},
        "vendor:sdl2":       {"title": "SDL Wiki", "url": "https://wiki.libsdl.org/SDL2/{name}"},
        "vendor:sdl2/image": {"title": "SDL Wiki", "url": "https://wiki.libsdl.org/SDL2_image/{name}"},
        "vendor:sdl2/mixer": {"title": "SDL Wiki", "url": "https://wiki.libsdl.org/SDL2_mixer/{name}"},
        "vendor:sdl2/ttf":   {"title": "SDL Wiki", "url": "https://wiki.libsdl.org/SDL2_ttf/{name}"},
        "vendor:sdl2/net":   {"title": "SDL Wiki", "url": "https://wiki.libsdl.org/SDL2_net/{name}"},
        "vendor:curl":       {"title": "libcurl", "url": "https://curl.se/libcurl/c/{name}.html"},
        "vendor:lua/5.4":    {"title": "Lua Manual", "url": "https://www.lua.org/manual/5.4/manual.html#{name}", "skip": ["luaopen_"]},
        "vendor:vulkan":     {"title": "Vulkan", "url": "https://registry.khronos.org/vulkan/specs/latest/man/html/{name}.html", "names": "vulkan"},
        "core:sys/windows":  {"title": "Microsoft Learn", "url": "https://learn.microsoft.com/en-us/search/?terms={name}", "names": "same"}
    },
    "objc_docs": {
        "url": "https://developer.apple.com/documentation/{framework}/{class}?language=objc",
        "packages": {
            "core:sys/darwin/Foundation": "foundation",
            "vendor:darwin/Metal": "metal",
            "vendor:darwin/QuartzCore": "quartzcore",
            "vendor:darwin/MetalKit": "metalkit"
        },
        "classes": {
            "NSApplication": "appkit",
            "NSBitmapImageRep": "appkit",
            "NSColor": "appkit",
            "NSColorSpace": "appkit",
            "NSCursor": "appkit",
            "NSEvent": "appkit",
            "NSImage": "appkit",
            "NSImageRep": "appkit",
            "NSMenu": "appkit",
            "NSMenuDelegate": "appkit",
            "NSMenuItem": "appkit",
            "NSOpenPanel": "appkit",
            "NSPanel": "appkit",
            "NSPasteboard": "appkit",
            "NSResponder": "appkit",
            "NSRunningApplication": "appkit",
            "NSSavePanel": "appkit",
            "NSScreen": "appkit",
            "NSToolbar": "appkit",
            "NSView": "appkit",
            "NSWindow": "appkit",
            "NSBundle": "foundation/bundle",
            "NSProcessInfo": "foundation/processinfo",
            "NSRunLoop": "foundation/runloop",
            "NSUndoManager": "foundation/undomanager",
            "NSObject": "objectivec",
            "NSObjectProtocol": "objectivec",
            "Protocol": "objectivec",
            "CALayer": "quartzcore",
            "NSBlock": ""
        }
    },
    "collections": {
        "base": {
            "name": "base",
            "source_url": "https://github.com/odin-lang/Odin/tree/master/base",
            "base_url": "/base",
            "root_path": "$ODIN_ROOT/base",
            "license": {
                "text": "zlib",
                "url": "https://github.com/odin-lang/Odin/tree/master/LICENSE"
            },
            "home": {
                "title": "Base",
                "description": "The base every Odin program builds on: the runtime, built-in procedures, and compiler intrinsics. Required by every target and implementation of Odin."
            }
        },
        "core": {
            "name": "core",
            "source_url": "https://github.com/odin-lang/Odin/tree/master/core",
            "base_url": "/core",
            "root_path": "$ODIN_ROOT/core",
            "license": {
                "text": "zlib",
                "url": "https://github.com/odin-lang/Odin/tree/master/LICENSE"
            },
            "home": {
                "title": "Core",
                "description": "The core library: formatted printing, strings, memory and allocators, containers, math, encoding, OS access, threading, and more."
            }
        },
        "vendor": {
            "name": "vendor",
            "source_url": "https://github.com/odin-lang/Odin/tree/master/vendor",
            "base_url": "/vendor",
            "root_path": "$ODIN_ROOT/vendor",
            "license": {
                "text": "zlib",
                "url": "https://github.com/odin-lang/Odin/tree/master/LICENSE"
            },
            "home": {
                "title": "Vendor",
                "description": "Bindings to popular third-party libraries for graphics, windowing, audio, physics, and more, all shipped with the compiler."
            }
        }
    }
}
